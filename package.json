{
  "name": "buddyevents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "USE_LOCAL_CONVEX=true vite dev",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success && convex dashboard",
    "convex:gen": "convex codegen",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "worker": "bun run tools/worker/main.ts",
    "cli": "bun run tools/cli/main.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.2.8",
    "@clerk/clerk-js": "^6.6.0",
    "@clerk/ui": "^1.5.0",
    "@crossmint/wallets-sdk": "^1.0.8",
    "@effect/cli": "^0.75.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-node": "^0.106.0",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/source-code-pro": "^5.2.7",
    "@opentui/core": "^0.1.97",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@wagmi/connectors": "^8.0.1",
    "@wagmi/core": "^3.4.2",
    "@x402/core": "^2.3.0",
    "@x402/evm": "^2.3.0",
    "@x402/fetch": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.7",
    "convex-svelte": "^0.0.12",
    "convex-vite-plugin": "^0.4.0",
    "effect": "^3.21.0",
    "lucide-svelte": "^1.0.1",
    "qrcode": "^1.5.4",
    "svelte": "^5.55.3",
    "tailwind-merge": "^3.4.0",
    "viem": "^2.47.11",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^9.39.2",
    "@convex-dev/eslint-plugin": "^1.1.1",
    "@effect/vitest": "^0.29.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.11",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.3.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.1.4"
  }
}
